__pycache__/
*.pyc
.venv
.pytest_cache/
server/data/
build/
client/.godot/
client/*.translation
tools/.lpc_cache/

# LPC downloads, pinned to one upstream commit (art.py): a cache, rebuilt on demand.
# Worktrees symlink the main checkout's copy (tools/dev.sh setup), so these match a symlink as well as a folder.
server/lpc_cache

# Raw 1024px FLUX outputs, kept on disk in the main checkout only (60 MB of PNGs).
docs/slots/flux_raw/
# Slot design boards (server/slot_designs/<id>/): the raw FLUX output and the framed character renders (six
# colours each) stay on disk only. The raw character busts are kept: the renders are rebuilt from them with
# `python -m casino_server.slot_design_art rebuild <design>`.
server/slot_designs/*/raw/*
!server/slot_designs/*/raw/bust_*.png
server/slot_designs/*/chars/

# Per-worktree scratch from tools/dev.sh: its port, database and logs.
.dev/

# Worktrees Claude Code creates inside the repo, and per-machine Claude settings.
.claude/worktrees/
.claude/settings.local.json

# Local OpenAI onboarding and external review.
/AGENTS.md
/docs/openai-review-2026-10-25.md
